# LAPRA 08 - Environment Variables untuk Production (Vercel)
# =====================================================
# 100% VERCEL FREE COMPLIANT — Tidak ada service berbayar
# Hanya 2 env vars WAJIB, sisanya OPSIONAL (tanpa env, tetap jalan)
# =====================================================

# === DATABASE (Neon PostgreSQL — FREE tier selamanya) ===
# Daftar: neon.tech → dapatkan connection string
# Free tier: 0.5 GB storage, 100 compute hours/bulan (cukup untuk LAPRA 08)
DATABASE_URL=postgresql://neondb_owner:****@ep-xxx.neon.tech/neondb?sslmode=require

# === AUTH (wajib untuk security) ===
# Generate random string: openssl rand -hex 32
NEXTAUTH_SECRET=lapra08-production-secret-2026
NEXT_PUBLIC_APP_URL=https://lapra08.vercel.app

# === EMAIL (OPSIONAL — tanpa ini, sistem pakai mailto: fallback) ===
# Resend.com FREE tier: 3,000 email/bulan, 100 email/hari (selamanya gratis)
# Daftar di resend.com → dapatkan API key → simpan di sini
# Jika TIDAK diset → email dibuka via mailto: link (kirim manual, 100% gratis)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=LAPRA 08 <onboarding@resend.dev>

# === CRON SECRET (OPSIONAL — untuk secure Vercel Cron) ===
# Jika diset, cron jobs harus pakai header Authorization: Bearer <secret>
# Jika TIDAK diset, cron tetap jalan (dev mode, less secure)
CRON_SECRET=lapra08-cron-secret-2026

# === REDIS (OPSIONAL — untuk BullMQ worker) ===
# Upstash Redis FREE tier: 10,000 commands/day (cukup untuk LAPRA 08)
# Hanya butuh jika menjalankan worker process (Railway/Fly.io/VPS)
# Jika TIDAK diset → queue fungsi fallback ke null (sistem tetap jalan)
UPSTASH_REDIS_URL=redis://default:xxx@xxx.upstash.io:6379

# === Z.AI SDK (TIDAK PERLU untuk production Vercel) ===
# z-ai-web-dev-sdk hanya dipakai di DEV environment (CLI tools)
# Production Vercel TIDAK pakai Z.AI SDK — semua AI 100% rule-based
# (keyword matching + template engine, no LLM, no API berbayar)
# ZAI_BASE_URL=https://internal-api.z.ai/v1  # TIDAK PERLU
# ZAI_API_KEY=Z.ai                          # TIDAK PERLU
# ZAI_CHAT_ID=chat-xxxx                     # TIDAK PERLU
# ZAI_TOKEN=eyJhbGciOi...                  # TIDAK PERLU
# ZAI_USER_ID=xxxxxxxx                      # TIDAK PERLU

# === INVIDIOUS (OPSIONAL — untuk YouTube scraping) ===
# Self-host Invidious instance untuk reliability (gratis, FOSS)
# Jika TIDAK diset → pakai public instances (gratis, tapi bisa down)
# INVIDIOUS_HOST=https://your-invidious.example.com

# === BAILEYS (OPSIONAL — untuk WhatsApp worker) ===
# Hanya butuh jika menjalankan worker process (Railway/Fly.io/VPS)
# Vercel Free tidak menjalankan worker (Baileys butuh WebSocket persistent)
# Notifikasi WA ke admin DPN pakai wa.me link (100% gratis, no Baileys)
# BAILEYS_AUTH_DIR=./baileys-auth
# BAILEYS_LOG_LEVEL=warn

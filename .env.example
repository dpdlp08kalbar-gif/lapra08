# LAPRA 08 - Environment Variables untuk Production (Vercel)
# =====================================================
# Set semua ini di Vercel Project Settings → Environment Variables
# (https://vercel.com/<your-org>/lapra08/settings/environment-variables)

# === DATABASE (Neon PostgreSQL) ===
DATABASE_URL=postgresql://neondb_owner:****@ep-lingering-unit-az9uc0ms-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# === EMAIL (Resend) ===
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=LAPRA 08 <onboarding@resend.dev>

# === AUTH ===
NEXTAUTH_SECRET=lapra08-production-secret-2026
NEXT_PUBLIC_APP_URL=https://lapra08.vercel.app

# === Z.AI SDK (untuk AI features: web search, LLM, VLM/OCR) ===
# WAJIB set untuk production — tanpa ini, fitur berikut akan gagal:
#   - Sinkronisasi berita (Pusat Media > Galeri Media > Sync)
#   - AI Essay Polling & auto-pertanyaan
#   - OCR Program Kerja PDF & SK Pengurus
#   - Opinion Links AI Summary
#
# Cara dapat: hubungi admin Z.AI atau jalankan di dev: cat /etc/.z-ai-config
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_API_KEY=Z.ai
ZAI_CHAT_ID=chat-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZAI_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
ZAI_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
